/pdf
/dist
/build
.DS_Store
.todos/

# sindri hub artifacts (agent worktrees + hub state) — not for the repo.
# config.yaml is the exception: the gate runs from a fresh checkout, so the
# checkout has to carry the config naming the gate script.
.sindri/*
!.sindri/config.yaml
.worktrees/


glossary/*.pdf
spec/*.pdf

# The docs backend is placed by scripts/fetch-ranke-docs.sh, never committed —
# a tree that vendored one would be pinned to a single rendering, which is the
# coupling the documentation format removes (G-SUPPLIED).
docs/vocabulary.typ
docs/handbook.typ
docs/papers/
