        <mxCell id="cnote" value="Either composition is itself a 𝒰, so they nest: a shard may be a stack, a tier may be a partition." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#374151;fontStyle=2" vertex="1" parent="1">
