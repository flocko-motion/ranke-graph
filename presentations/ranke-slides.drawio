          <mxGeometry x="634" y="518" width="26" height="26" as="geometry" />
        </mxCell>

        <mxCell id="badgenote" value="⟨⟩ &amp;nbsp;also answers a query natively.&lt;br&gt;Substrates are interchangeable for &lt;b&gt;correctness&lt;/b&gt;,&lt;br&gt;not for &lt;b&gt;capability&lt;/b&gt;: a query&apos;s meaning is unchanged&lt;br&gt;by which layer answers it." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="195" y="606" width="500" height="70" as="geometry" />
        </mxCell>

        <mxCell id="tuple" value="RA&lt;sub&gt;k&lt;/sub&gt; = (𝒰, k)&lt;br&gt;&lt;font style=&quot;font-size: 11px&quot; color=&quot;#4b5563&quot;&gt;an archive is a universe&lt;br&gt;plus one head id&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#9ca3af;fontSize=14;arcSize=8;" vertex="1" parent="1">
