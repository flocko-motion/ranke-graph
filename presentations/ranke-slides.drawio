        <mxCell id="waistnote" value="everything above is expressed in claims;&lt;br&gt;everything below merely stores them" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#4b5563;fontStyle=2" vertex="1" parent="1">
