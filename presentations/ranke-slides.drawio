        <mxCell id="apps" value="Applications&lt;br&gt;&lt;font style=&quot;font-size: 12px&quot; color=&quot;#4b5563&quot;&gt;knowledge base &amp;#183; software provenance &amp;#183; searchable backup &amp;#183; …&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=14;arcSize=8;" vertex="1" parent="1">
