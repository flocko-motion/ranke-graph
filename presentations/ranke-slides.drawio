  <diagram name="Archival Tradition" id="gZKDeSdHPmIpuqpPiHgV">
    <mxGraphModel dx="1717" dy="1047" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" backgroundImage="{&quot;src&quot;:&quot;data:page/id,QbE8TqDRo5yMwSRJmee9&quot;}" math="0" shadow="0">
      <root>
        <mxCell id="bv79ca_Agd_uZUfDqwpm-0" />
        <mxCell id="bv79ca_Agd_uZUfDqwpm-1" parent="bv79ca_Agd_uZUfDqwpm-0" />
        <mxCell id="bv79ca_Agd_uZUfDqwpm-39" parent="bv79ca_Agd_uZUfDqwpm-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=default;labelBackgroundColor=none;fontStyle=1" value="Leopold von Ranke (1795–1886)&amp;nbsp;&lt;div&gt;and the Archival Tradition&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="57" width="413" x="162" y="80" as="geometry" />
        </mxCell>
        <mxCell id="nxRHWmOnE96wtaFAm2rf-1" parent="bv79ca_Agd_uZUfDqwpm-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=default;labelBackgroundColor=none;fontStyle=1" value="Modern IT" vertex="1">
          <mxGeometry height="39" width="358" x="961" y="89" as="geometry" />
        </mxCell>
        <mxCell id="nxRHWmOnE96wtaFAm2rf-7" parent="bv79ca_Agd_uZUfDqwpm-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="212" width="163.97" x="286.515" y="159" as="geometry" />
        </mxCell>
        <mxCell id="nxRHWmOnE96wtaFAm2rf-8" parent="bv79ca_Agd_uZUfDqwpm-1" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" value="" vertex="1">
          <mxGeometry height="212" width="165.16" x="1057.42" y="159" as="geometry" />
        </mxCell>
        <mxCell id="nxRHWmOnE96wtaFAm2rf-10" parent="bv79ca_Agd_uZUfDqwpm-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=default;labelBackgroundColor=none;" value="&lt;div&gt;- One archive. Records keep the context they came from.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Kept as long as possible. Nothing is altered — new records cite old ones instead of replacing them. Every removal is documented.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- One catalogue number: unique, permanent, uniform. Any record can cite any other.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;…and it can outlive the institution that filed it.&lt;/div&gt;" vertex="1">
          <mxGeometry height="277" width="664" x="60" y="405" as="geometry" />
        </mxCell>
        <mxCell id="nxRHWmOnE96wtaFAm2rf-18" parent="bv79ca_Agd_uZUfDqwpm-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=default;labelBackgroundColor=none;" value="&lt;div&gt;- One store per tool. Nothing joins across them.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Each tool has its own retention policy: some records are kept forever, others are updated in place or purged on a schedule.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- What is versioned, what is referenceable, what survives an export: different in every tool. A patchwork of policies.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;…and all of it ends when the tool is replaced.&lt;/div&gt;" vertex="1">
          <mxGeometry height="232" width="652" x="826" y="405" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="The Problem" id="YUvP3DGfLSi5mbT5wOsx">
    <mxGraphModel dx="1585" dy="966" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" backgroundImage="{&quot;src&quot;:&quot;data:page/id,QbE8TqDRo5yMwSRJmee9&quot;}" math="0" shadow="0">
      <root>
        <mxCell id="BscfqlxZEgS1esf_7trp-0" />
        <mxCell id="BscfqlxZEgS1esf_7trp-1" parent="BscfqlxZEgS1esf_7trp-0" />
        <mxCell id="BscfqlxZEgS1esf_7trp-2" parent="BscfqlxZEgS1esf_7trp-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontFamily=Helvetica;fontSize=22;fontColor=default;labelBackgroundColor=none;fontStyle=1" value="Everything is filed. Nothing is findable." vertex="1">
          <mxGeometry height="57" width="541" x="530" y="71" as="geometry" />
        </mxCell>
        <mxCell id="BscfqlxZEgS1esf_7trp-6" parent="BscfqlxZEgS1esf_7trp-1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Helvetica;fontSize=21;fontColor=default;labelBackgroundColor=none;" value="&lt;div&gt;- One piece of work leaves traces everywhere: a ticket, a chat message, an email, a document, a wiki page, a log.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Every tool has its own search. To find something, you already have to know where it is.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Every tool has its own retention: some keep everything forever, some purge on a schedule, some overwrite on every update.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- And time makes it worse: people leave, projects close, tools get replaced.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Against that background, reconstructing how a decision was made a year ago is the hard case: it needs the logs, the communication, the code, the artifacts and the database state of the time — all in one place.&lt;/div&gt;" vertex="1">
          <mxGeometry height="482" width="664" x="776" y="220" as="geometry" />
        </mxCell>
        <mxCell id="s-apXvDmDvkNDDdRBJVd-12" connectable="0" parent="BscfqlxZEgS1esf_7trp-1" style="group" value="" vertex="1">
