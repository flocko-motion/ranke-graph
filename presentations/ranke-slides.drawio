        <mxCell id="stackframe" value="stack &amp;#8212; ordered tiers, read-through / write-through" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#60a5fa;dashed=1;verticalAlign=top;fontSize=14;fontStyle=1;fontColor=#1d4ed8;arcSize=6;" vertex="1" parent="1">
