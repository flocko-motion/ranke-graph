        <mxCell id="title" value="RankeDB: one claim model, interchangeable substrates" style="text;html=1;align=center;verticalAlign=middle;fontSize=20;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="195" y="0" width="780" height="40" as="geometry" />
